# Sensor Temperature Tracker - Environment Variables
# Copy this file to .env and edit as needed (optional)
# Usage: source .env && ./temp-tracker

# HTTP server
PORT=9091

# Temperature sensor polling
TEMP_POLL_INTERVAL=30
TEMP_RETAIN_HOURS=8760

# System metric polling intervals (seconds)
CPU_POLL_INTERVAL=30
MEMORY_POLL_INTERVAL=10
SWAP_POLL_INTERVAL=60
DISK_POLL_INTERVAL=60
LOAD_POLL_INTERVAL=10

# Retention periods (hours)
CPU_RETAIN_HOURS=24
MEMORY_RETAIN_HOURS=24
SWAP_RETAIN_HOURS=168
DISK_RETAIN_HOURS=168
LOAD_RETAIN_HOURS=24

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
