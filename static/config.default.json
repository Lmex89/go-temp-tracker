{
  "_comment": "DEFAULT CONFIGURATION - All sensors visible, no filtering",
  "_comment2": "Copy this file to config.json to restore defaults",

  "defaultTimeRange": {
    "value": "6h"
  },

  "refreshIntervals": {
    "currentTempMs": 60000,
    "chartDataMs": 60000
  },

  "colors": {
    "palette": [
      "#38bdf8", "#4ade80", "#f472b6", "#fbbf24",
      "#a78bfa", "#fb7185", "#22d3ee", "#a3e635"
    ]
  },

  "chart": {
    "lineTension": 0.3,
    "pointRadius": 2,
    "fillArea": false,
    "yAxisMin": null,
    "yAxisMax": null,
    "showGridLines": true,
    "maxTicksLimit": 12
  },

  "display": {
    "decimalPlaces": 1,
    "showLastUpdated": true,
    "timeFormat24h": true
  },

  "zoom": {
    "wheelEnabled": true,
    "dragEnabled": true,
    "pinchEnabled": true
  },

  "gauge": {
    "cpuMax": 100,
    "ramMax": 100,
    "swapMax": 100,
    "diskMax": 100
  },

  "gaugeRefreshMs": {
    "cpu": 60000,
    "ram": 60000,
    "swap": 60000,
    "disk": 60000
  },

  "sensorFilter": {
    "enabled": false,
    "includePatterns": []
  }
}
